<install>
  <update file="${package.root}/install/bundles" todir="${env.bundles}" />
  <copy dir="${package.root}/web" todir="${env.server.home}/nxserver" overwrite="true" />
  <!--
    Customer-editable configuration, deliberately installed *beside* the
    application bundle rather than inside it.

    The copy above replaces the whole `web` tree with overwrite="true", so a
    configuration file under `nuxeo.war/agentic-ui` would be destroyed on every
    upgrade. `nuxeo.war/agentic-ui-config` is not in that copy's source tree, and
    overwrite="false" means an existing deployed file is left untouched — so this
    step seeds the defaults on a first install and preserves customer edits on
    every upgrade after it.
  -->
  <copy dir="${package.root}/config"
        todir="${env.server.home}/nxserver/web/nuxeo.war/agentic-ui-config"
        overwrite="false" />
</install>
