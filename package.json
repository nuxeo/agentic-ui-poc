    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "openai": "^6.33.0",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "overrides": {
    "@angular-devkit/architect": "0.1902.23",
    "@angular/build": {
      "vite": "6.4.3"
    },
    "@angular-devkit/build-angular": {
      "vite": "6.4.3"
    },
    "axios": ">=1.18.0",
    "body-parser": ">=2.3.0",
    "brace-expansion": ">=2.0.2",
