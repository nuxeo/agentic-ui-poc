    "http-proxy-middleware": "3.0.7",
    "immutable": "5.1.9",
    "js-yaml": "5.2.3",
    "postcss": "8.5.25",
    "piscina": "5.3.0",
    "qs": "6.15.3",
    "serialize-javascript": "7.0.7",
