    "@angular/platform-browser-dynamic": "~20.3.0",
    "@angular/router": "~20.3.0",
    "@hylandsoftware/hxcs-js-client": "2.0.111",
    "@hylandsoftware/satori-ui": "^0.2.0",
    "@mat-datetimepicker/core": "16.0.1",
    "@ngx-translate/core": "^17.0.0",
    "angular-oauth2-oidc": "19.0.0",
    "cropperjs": "1.6.2",
    "date-fns": "2.30.0",
    "dompurify": "^3.4.12",
    "minimatch": "10.2.6",
    "ng-mocks": "file:tools/stubs/ng-mocks",
    "pdfjs-dist": "6.2.108",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@alfresco/js-api": "10.0.0",
    "@analogjs/vite-plugin-angular": "~1.22.5",
    "@analogjs/vitest-angular": "~1.22.5",
