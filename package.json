{
  "name": "agentic-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "nx serve nuxeo-ui",
    "start": "nx serve",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "prepare": "husky",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "review:guardrails": "node scripts/review-guardrails.mjs",
    "review:preflight": "npm run review:guardrails && npx nx affected -t lint && npx nx affected -t test"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "~19.2.0",
    "@angular/cdk": "~19.2.0",
    "@angular/common": "~19.2.0",
    "@angular/compiler": "~19.2.0",
    "@angular/core": "~19.2.0",
    "@angular/forms": "~19.2.0",
    "@angular/material": "~19.2.0",
    "@angular/platform-browser": "~19.2.0",
    "@angular/platform-browser-dynamic": "~19.2.0",
    "@angular/router": "~19.2.0",
    "@hylandsoftware/satori-ui": "^0.1.5",
    "@ngx-translate/core": "^17.0.0",
    "cors": "^2.8.6",
    "dompurify": "^3.3.3",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "openai": "^6.33.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "overrides": {
    "@angular-devkit/architect": "0.1902.23"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~1.14.1",
    "@analogjs/vitest-angular": "~1.14.1",
    "@angular-devkit/build-angular": "~19.2.0",
    "@angular-devkit/core": "~19.2.0",
    "@angular-devkit/schematics": "~19.2.0",
    "@angular/build": "~19.2.0",
    "@angular/cli": "~19.2.0",
    "@angular/compiler-cli": "~19.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "22.6.3",
    "@nx/eslint": "22.7.2",
    "@nx/eslint-plugin": "22.6.3",
    "@nx/js": "^22.6.3",
    "@nx/vite": "22.6.3",
    "@nx/vitest": "22.6.3",
    "@nx/workspace": "22.6.3",
    "@oxc-project/runtime": "^0.115.0",
    "@schematics/angular": "~19.2.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/jasmine": "^6.0.0",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "~3.0.0",
    "@vitest/ui": "~3.0.0",
    "angular-eslint": "^19.2.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jasmine-core": "^6.1.0",
    "jsdom": "^28.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "lint-staged": "^16.4.0",
    "nx": "22.6.3",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "tsx": "^4.21.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
