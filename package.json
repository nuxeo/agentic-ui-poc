    "@nx/vite": "22.7.8",
    "@nx/vitest": "22.7.8",
    "@nx/workspace": "22.7.8",
    "@oxc-project/runtime": "^0.115.0",
    "@schematics/angular": "~20.3.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/jasmine": "^6.0.0",
