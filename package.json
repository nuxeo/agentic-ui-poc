{
  "name": "agentic-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "nx serve nuxeo-ui",
    "start": "nx serve",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "prepare": "husky",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "review:guardrails": "node scripts/review-guardrails.mjs",
    "review:preflight": "npm run review:guardrails && npx nx affected -t lint && npx nx affected -t test",
    "evidence:collect": "node scripts/collect-evidence/runner.mjs"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "~19.2.0",
    "@angular/cdk": "~19.2.0",
    "@angular/common": "~19.2.0",
    "@angular/compiler": "~19.2.0",
