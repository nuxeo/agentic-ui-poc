{
  "name": "nuxeo-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing Nuxeo repository operations (search, documents, automation, schemas)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nuxeo-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "nuxeo",
