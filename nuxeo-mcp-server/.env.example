# Full Nuxeo base URL including /nuxeo (no trailing slash)
NUXEO_URL=http://localhost:8080/nuxeo

# Basic auth (typical for dev)
NUXEO_USER=Administrator
NUXEO_PASSWORD=Administrator

# Or Bearer token instead of Basic (set NUXEO_TOKEN and leave user/password empty)
# NUXEO_TOKEN=

# Optional: block create_document and run_automation
# NUXEO_READ_ONLY=false

# Optional: comma-separated automation operation IDs allowed for run_automation (empty = all)
# NUXEO_AUTOMATION_ALLOWLIST=Document.Query,Search.SuggestersLauncher
