# ============================================================
# AI Backend — Environment Variables
# Copy this file to .env.ai-backend at the project root and
# fill in all values marked with <...> before starting the
# Docker container.
# ============================================================

# ------------------------------------------------------------
# HAIP Model Gateway (Hyland AI Platform — LiteLLM)
# Docs: https://hyland.atlassian.net/wiki/spaces/cin/pages/3012921198
# Key rotation: https://hyland.atlassian.net/wiki/spaces/cin/pages/3138879505
# ------------------------------------------------------------

# Public dev gateway endpoint (no VPN required)
HAIP_BASE_URL=https://ai-platform-public.api.ai.dev.app.hyland.com

# Retrieve from AWS Secrets Manager in the CIN account:
#   Secret ARN: arn:aws:secretsmanager:us-east-1:662386863434:secret:cin/mlp/litellm/idp_key
#   Command:    aws secretsmanager get-secret-value --secret-id arn:aws:secretsmanager:us-east-1:662386863434:secret:cin/mlp/litellm/idp_key
# Key rotates every 90 days — redeploy when notified by the HAIP team.
HAIP_API_KEY=<retrieve-from-aws-secrets-manager>

# Model for high-quality responses (document insights, classification, etc.)
HAIP_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Model for fast/cheap responses (tagging, NL queries, sentiment, etc.)
HAIP_MODEL_FAST=amazon.nova-micro-v1:0

# Embedding model for semantic search and RAG
HAIP_EMBEDDING_MODEL=bedrock-amazon-titan-text-embeddings-v2

# Environment ID provided by the HAIP team for usage tracking
HAIP_ENVIRONMENT_ID=<get-from-haip-team>

# ------------------------------------------------------------
# Nuxeo Server Connection
# ------------------------------------------------------------

# Internal URL of the Nuxeo server reachable from within Docker network
# Use host.docker.internal if Nuxeo runs on the host, or the container name if on the same network
NUXEO_URL=http://host.docker.internal:8080/nuxeo

# Nuxeo admin credentials for server-side API calls
NUXEO_AUTH=Administrator:<password>

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Comma-separated list of allowed origins (the Angular UI host)
AI_BACKEND_ALLOWED_ORIGINS=http://<angular-ui-host>

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=3000

# ============================================================
# nginx reverse proxy config snippet
# Add the following location block to your nginx config so the
# Angular UI can reach the AI backend:
#
#   location /ai/ {
#       proxy_pass         http://ai-backend:3000;
#       proxy_http_version 1.1;
#       proxy_set_header   Host $host;
#       proxy_set_header   X-Real-IP $remote_addr;
#       proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
#       proxy_read_timeout 120s;
#   }
# ============================================================
