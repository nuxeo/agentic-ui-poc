# ============================================================
# AI Backend — Environment Variables
# Copy this file to apps/ai-backend/.env and fill in values.
# ============================================================

# ------------------------------------------------------------
# OpenAI API
# Docs: https://platform.openai.com/docs/api-reference
# Get your key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------

# Your OpenAI API key (required)
OPENAI_API_KEY=<your-openai-api-key>

# Models (optional — defaults shown below)
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------
# Nuxeo Server Connection
# ------------------------------------------------------------

# URL of the Nuxeo server
NUXEO_URL=http://localhost:8080

# Nuxeo credentials for server-side API calls
NUXEO_AUTH=Administrator:<password>

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=3000
