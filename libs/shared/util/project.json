{
  "name": "shared-util",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/util/src",
  "projectType": "library",
  "tags": ["npm:private", "scope:shared", "type:util"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "$comment": "@nx/eslint/plugin infers this as `eslint:lint`, which `nx affected -t lint` does NOT match — so the gate and CI never linted this project. Declaring it explicitly is what puts it under the gate."
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/util",
        "main": "libs/shared/util/src/index.ts",
        "tsConfig": "libs/shared/util/tsconfig.lib.json",
        "assets": ["libs/shared/util/*.md"]
      }
    }
  }
}
