{
  "name": "platform",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/platform/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:publishable"],
  "implicitDependencies": ["shared-extensions", "shared-app-config", "nuxeo-client", "ui"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "$comment": "@nx/eslint/plugin infers this as `eslint:lint`, which `nx affected -t lint` does NOT match \u2014 so the gate and CI never linted this project. Declaring it explicitly is what puts it under the gate."
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/platform"],
      "cache": true,
      "options": {
        "project": "libs/platform/ng-package.json",
        "tsConfig": "libs/platform/tsconfig.lib.json"
      },
      "dependsOn": ["sync-docs"]
    },
    "sync-docs": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/docs/extension-reference.md",
        "{workspaceRoot}/scripts/sync-platform-docs.mjs"
      ],
      "outputs": ["{projectRoot}/extension-reference.md"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node scripts/sync-platform-docs.mjs"
      },
      "$comment": "ng-packagr refuses assets from outside the package root, so the customer-facing docs are copied in before the build. The copies are gitignored \u2014 docs/ is the single source."
    }
  }
}
