  title: 'Components/<%= title %>',
  component: <%= className %>,
  args: { heading: '<%= title %>'<% if (isDocumentView) { %>, document: null<% } %> },
};

export default meta;

type Story = StoryObj<<%= className %>>;

export const Default: Story = {};
