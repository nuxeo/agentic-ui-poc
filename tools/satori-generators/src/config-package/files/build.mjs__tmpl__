#!/usr/bin/env node
/**
 * Build this configuration package: check it the way the server will, then write the zip.
 *
 *   node build.mjs [--out <directory>]        (default: ./dist next to this file)
 *
 * Generated by `@nuxeo-satori/platform:config-package`. No dependencies, so it runs anywhere Node
 * 20 does. The output is byte-for-byte reproducible — fixed timestamps, entries sorted by code
 * point rather than by the machine's locale — so the same reviewed source always produces the
 * same artifact.
 *
 * Refused, each with the file and the reason — every one would stop the change applying, without
 * failing the install. The first four are the checks `ContributionRegistry` and `ConfigSnapshot`
 * in nuxeo-agentic-core make on each entry of the component XML, which the server reports in its
 * log and leaves out:
 *   - a fragment whose layer is not `bootstrap` or `manifest`, or whose name is not letters,
 *     digits, `.`, `_` and `-`; a layout whose type or mode is not a valid name; an `<asset>`
 *     whose name is not a plain image file name. Checked on a disabled entry too, as the server
 *     does;
 *   - an enabled entry with no body, or a fragment or layout with both a `src` and inline
 *     `<json>`;
 *   - a `src` that names no packaged file in `bundle/` — a directory or a Markdown file is not one;
 *   - a fragment or layout body — a `src` file whatever its name, or inline `<json>` — that does
 *     not parse, is not an object, repeats a key, or is packaged over 1 MiB; an asset over 2 MiB;
 *   - a component contributing configuration without
 *     `<require>org.nuxeo.agentic.ui.config.defaults</require>`, without which this package's
 *     fragments could register before Satori's own and lose to them;
 *   - a symbolic link anywhere under `bundle/`, which would package bytes from outside what was
 *     reviewed — and an asset is served without authentication.
 *
 * Packaged: everything under `bundle/` except Markdown files. Every `.json` file, and any other
 * file a fragment or layout names as its `src`, is packaged compact, with a top-level `"$schema"`
 * key removed (it is for your editor, not the server).
 */
import { createHash } from 'node:crypto';
import { existsSync, lstatSync, mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';
import { dirname, join, relative, resolve, sep } from 'node:path';
import { fileURLToPath } from 'node:url';
import { deflateRawSync } from 'node:zlib';

const HERE = dirname(fileURLToPath(import.meta.url));
const BUNDLE = join(HERE, 'bundle');
// The server's limits and name rules: `ConfigSnapshot` and `ContributionRegistry` in
// nuxeo-agentic-core.
const MAX_JSON_BYTES = 1024 * 1024;
const MAX_ASSET_BYTES = 2 * 1024 * 1024;
const NAME = /^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/;
const TYPE = /^[A-Za-z][A-Za-z0-9_-]{0,127}$/;
const MODE = /^[a-z][a-z0-9-]{0,31}$/;
const ASSET_NAME =
  /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?:\.[A-Za-z0-9_-]{1,32}){0,3}\.(?:svg|png|jpg|jpeg|gif|webp|ico)$/i;
const DEFAULTS_COMPONENT = 'org.nuxeo.agentic.ui.config.defaults';
const MANIFEST_ENTRY = 'META-INF/MANIFEST.MF';

const outIndex = process.argv.indexOf('--out');
const OUT = resolve(outIndex > 0 ? process.argv[outIndex + 1] : join(HERE, 'dist'));

const problems = [];
const problem = (file, message) => problems.push(`${relative(HERE, file)}: ${message}`);

/** The files under `directory`. A symbolic link is refused, not followed: it could reach outside. */
function filesUnder(directory) {
  return readdirSync(directory).flatMap((entry) => {
    const path = join(directory, entry);
    const stat = lstatSync(path);
    if (stat.isSymbolicLink()) {
      problem(path, 'is a symbolic link; put the file itself in bundle/, so the package holds only what was reviewed');
      return [];
    }
    return stat.isDirectory() ? filesUnder(path) : [path];
  });
}

const isFile = (path) => lstatSync(path, { throwIfNoEntry: false })?.isFile() === true;
/** What goes into the bundle. The one predicate for packaging and for checking a `src`. */
const isPackaged = (path) => isFile(path) && !path.endsWith('.md');

/**
 * Throws on a repeated key, which `JSON.parse` would accept by keeping the last value and the
 * server refuses. Validation only — the value is taken from `JSON.parse` afterwards.
 */
function rejectDuplicateKeys(text) {
  let i = 0;
  const token = (pattern) => {
    pattern.lastIndex = i;
    const match = pattern.exec(text);
    if (!match) throw new Error(`unexpected input at offset ${i}`);
    i = pattern.lastIndex;
    return match[0];
  };
  const STRING = /"(?:[^"\\\u0000-\u001f]|\\(?:["\\/bfnrt]|u[0-9a-fA-F]{4}))*"/y;
  const LITERAL = /-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?|true|false|null/y;
  const space = () => token(/[ \t\n\r]*/y);
  const value = (path) => {
    space();
    if (text[i] === '{') return object(path);
    if (text[i] === '[') return array(path);
    token(text[i] === '"' ? STRING : LITERAL);
  };
  const object = (path) => {
    i++;
    const seen = new Set();
    space();
    if (text[i] === '}') return void i++;
    for (;;) {
      space();
      const key = JSON.parse(token(STRING));
      if (seen.has(key)) throw new Error(`duplicate key "${key}" in ${path || 'the top level'}`);
      seen.add(key);
      space();
      token(/:/y);
      value(path ? `${path}.${key}` : key);
      space();
      if (text[i] === ',') i++;
      else if (text[i] === '}') return void i++;
      else throw new Error(`expected "," or "}" at offset ${i}`);
    }
  };
  const array = (path) => {
    i++;
    space();
    if (text[i] === ']') return void i++;
    for (let index = 0; ; index++) {
      value(`${path}[${index}]`);
      space();
      if (text[i] === ',') i++;
      else if (text[i] === ']') return void i++;
      else throw new Error(`expected "," or "]" at offset ${i}`);
    }
  };
  value('');
  space();
  if (i !== text.length) throw new Error(`unexpected input after the value at offset ${i}`);
}

/**
 * XML with its comments removed. Inside CDATA `<!--` is text, so a CDATA section is kept whole.
 * Comments do not nest; an unterminated comment or CDATA section runs to the end.
 */
function withoutComments(xml) {
  let out = '';
  let at = 0;
  for (;;) {
    const start = xml.indexOf('<!--', at);
    if (start < 0) return out + xml.slice(at);
    const cdata = xml.indexOf('<![CDATA[', at);
    if (cdata >= 0 && cdata < start) {
      const end = xml.indexOf(']]>', cdata);
      const stop = end < 0 ? xml.length : end + 3;
      out += xml.slice(at, stop);
      at = stop;
      continue;
    }
    out += xml.slice(at, start);
    const end = xml.indexOf('-->', start + 4);
    if (end < 0) return out;
    at = end + 3;
  }
}

/** The same XML with every CDATA section blanked, so markup is never matched inside text. */
const withoutCdata = (xml) => xml.replace(/<!\[CDATA\[[\s\S]*?(?:\]\]>|$)/g, (section) => ' '.repeat(section.length));

const ENTITIES = { lt: '<', gt: '>', amp: '&', quot: '"', apos: "'" };

/** XML character data with its character and predefined entity references resolved. */
function decode(text) {
  return text.replace(/&(?:#x([0-9A-Fa-f]+)|#([0-9]+)|(lt|gt|amp|quot|apos));/g, (reference, hex, decimal, named) => {
    if (named) return ENTITIES[named];
    const codePoint = hex ? parseInt(hex, 16) : Number(decimal);
    return codePoint <= 0x10ffff ? String.fromCodePoint(codePoint) : reference;
  });
}

/** Every `name="value"` or `name='value'` attribute of one start tag, trimmed as Nuxeo reads it. */
function attributes(tag) {
  const found = {};
  for (const [, name, , double, single] of tag.matchAll(/([\w:.-]+)\s*=\s*("([^"]*)"|'([^']*)')/g)) {
    found[name] = decode(double ?? single).trim();
  }
  return found;
}

/**
 * The text of the `<json>` child of the `<element>` whose start tag ends at `from` — CDATA kept
 * verbatim, references resolved, trimmed — or `undefined` when it has none.
 */
function inlineJson(xml, from, element) {
  const closesElement = new RegExp(`^/${element}\\s*$`);
  let text;
  for (let at = from; ; ) {
    const lt = xml.indexOf('<', at);
    if (text !== undefined) text += decode(xml.slice(at, lt < 0 ? xml.length : lt));
    if (lt < 0) return text?.trim();
    if (xml.startsWith('<![CDATA[', lt)) {
      const end = xml.indexOf(']]>', lt);
      if (text !== undefined) text += xml.slice(lt + 9, end < 0 ? xml.length : end);
      if (end < 0) return text?.trim();
      at = end + 3;
      continue;
    }
    const gt = xml.indexOf('>', lt);
    if (gt < 0) return text?.trim();
    const tag = xml.slice(lt + 1, gt);
    at = gt + 1;
    if (text === undefined) {
      if (closesElement.test(tag)) return undefined;
      if (/^json\b/.test(tag)) {
        if (tag.trimEnd().endsWith('/')) return '';
        text = '';
      }
    } else if (/^\/json\s*$/.test(tag)) {
      return text.trim();
    }
  }
}

/** The server's checks on a fragment or layout body: it parses, repeats no key, is an object. */
function parseObject(text, report) {
  let parsed;
  try {
    parsed = JSON.parse(text);
    rejectDuplicateKeys(text);
  } catch (error) {
    report(error.message);
    return null;
  }
  if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
    report('must be a JSON object');
    return null;
  }
  return parsed;
}

/** A JSON file as packaged, compact and without `$schema`; `null` if the server would refuse it. */
function checkJson(file) {
  const parsed = parseObject(readFileSync(file, 'utf8'), (message) => problem(file, message));
  if (!parsed) return null;
  delete parsed.$schema;
  // The limit applies to what is packaged, which is what the server reads.
  const packaged = Buffer.from(JSON.stringify(parsed));
  if (packaged.length > MAX_JSON_BYTES) {
    problem(
      file,
      `packaged as ${packaged.length} bytes; the server refuses a fragment or layout over ${MAX_JSON_BYTES}`,
    );
    return null;
  }
  return packaged;
}

/** Why the server rejects this entry whatever its body, as `ContributionRegistry.validate` says. */
function invalidEntry(element, { name, layer, type, mode }) {
  if (element === 'fragment') {
    if (layer !== 'bootstrap' && layer !== 'manifest') {
      return `fragment "${name ?? ''}" has layer "${layer ?? ''}"; it must be "bootstrap" or "manifest"`;
    }
    if (!NAME.test(name ?? '')) {
      return `fragment name "${name ?? ''}" must be letters, digits, ".", "_" or "-"`;
    }
  } else if (element === 'layout') {
    if (!TYPE.test(type ?? '')) return `layout type "${type ?? ''}" is not a document type name`;
    if (!MODE.test(mode ?? '')) {
      return `layout mode "${mode ?? ''}" must be lower-case letters, digits or "-"`;
    }
  } else if (!ASSET_NAME.test(name ?? '')) {
    return `asset name "${name ?? ''}" must be a plain file name ending in .svg, .png, .jpg, .jpeg, .gif, .webp or .ico`;
  }
  return null;
}

// ------------------------------------------------------------------ package.xml

const packageXmlFile = join(HERE, 'package', 'package.xml');
const packageXml = readFileSync(packageXmlFile, 'utf8');
const { name: packageName, version: packageVersion } = attributes(
  /<package\b([^>]*)>/.exec(withoutCdata(withoutComments(packageXml)))?.[1] ?? '',
);
if (!packageName || !packageVersion) problem(packageXmlFile, '<package> needs a name and a version');

// ------------------------------------------------------------------ bundle

const manifestFile = join(BUNDLE, 'META-INF', 'MANIFEST.MF');
const manifest = existsSync(manifestFile) ? readFileSync(manifestFile, 'utf8') : '';
const componentPaths = (/^Nuxeo-Component:\s*(.+?)\s*$/m.exec(manifest)?.[1] ?? '')
  .split(',')
  .map((path) => path.trim())
  .filter(Boolean);
if (componentPaths.length === 0) problem(manifestFile, 'needs a Nuxeo-Component line');

/** Fragment and layout bodies named by `src`: JSON whatever the file is called. */
const jsonBodies = new Set();

for (const componentPath of componentPaths) {
  const componentFile = join(BUNDLE, componentPath);
  if (!existsSync(componentFile)) {
    problem(manifestFile, `Nuxeo-Component names ${componentPath}, which does not exist`);
    continue;
  }
  // Comments removed first, so a commented-out example can neither satisfy nor fail a check.
  // Line endings normalised, as an XML parser does before the server measures inline JSON.
  const xml = withoutComments(readFileSync(componentFile, 'utf8').replace(/\r\n?/g, '\n'));
  // Markup is looked for here; text, including inline JSON, is read from `xml` at the same offsets.
  const markup = withoutCdata(xml);
  const contributes = [...markup.matchAll(/<extension\b([^>]*)>/g)].some(
    ([, tag]) => attributes(tag).target === 'org.nuxeo.agentic.ui.config',
  );
  const requiresDefaults = /<require>\s*org\.nuxeo\.agentic\.ui\.config\.defaults\s*<\/require>/.test(markup);
  if (contributes && !requiresDefaults) {
    problem(
      componentFile,
      `must <require>${DEFAULTS_COMPONENT}</require>, or its fragments may apply before Satori's defaults`,
    );
  }
  for (const match of markup.matchAll(/<(fragment|layout|asset)\b([^>]*)>/g)) {
    const [startTag, element, tag] = match;
    const entry = attributes(tag);
    const invalid = invalidEntry(element, entry);
    if (invalid) {
      problem(componentFile, invalid);
      continue;
    }
    const { name, layer, type, mode, src } = entry;
    const label =
      element === 'layout' ? `layout ${type}/${mode}` : `${element} "${name}"${layer ? ` in ${layer}` : ''}`;
    // Anything but "true" disables, as Nuxeo reads a boolean. A disabled entry removes an earlier
    // contribution; it has no body to check.
    if (entry.enabled !== undefined && entry.enabled.toLowerCase() !== 'true') continue;

    const json =
      element === 'asset' || tag.trimEnd().endsWith('/')
        ? undefined
        : inlineJson(xml, match.index + startTag.length, element);
    const hasJson = json !== undefined && json !== '';
    if (src && hasJson) {
      problem(componentFile, `${label} has both a src and inline JSON; use one`);
      continue;
    }
    if (!src && !hasJson) {
      problem(componentFile, `${label} has ${element === 'asset' ? 'no src' : 'neither a src nor inline JSON'}`);
      continue;
    }
    if (hasJson) {
      const report = (message) => problem(componentFile, `inline JSON of ${label}: ${message}`);
      const size = Buffer.byteLength(json);
      if (parseObject(json, report) && size > MAX_JSON_BYTES) {
        report(`${size} bytes; the server refuses a fragment or layout over ${MAX_JSON_BYTES}`);
      }
      continue;
    }

    const target = resolve(BUNDLE, src);
    if (!target.startsWith(BUNDLE + sep) || !isFile(target)) {
      problem(componentFile, `src="${src}" names no file in bundle/`);
      continue;
    }
    if (!isPackaged(target)) {
      problem(componentFile, `src="${src}" names a Markdown file, which is not packaged`);
      continue;
    }
    if (element !== 'asset') {
      jsonBodies.add(target);
      continue;
    }
    const size = statSync(target).size;
    if (size > MAX_ASSET_BYTES) {
      problem(target, `${size} bytes; the server refuses an asset over ${MAX_ASSET_BYTES}`);
    }
  }
}

const entries = [];
for (const file of filesUnder(BUNDLE).sort()) {
  if (!isPackaged(file)) continue;
  const name = relative(BUNDLE, file).split(sep).join('/');
  const data = file.endsWith('.json') || jsonBodies.has(file) ? checkJson(file) : readFileSync(file);
  if (data) entries.push({ name, data });
}

if (problems.length > 0) {
  console.error(`\n${packageName ?? 'configuration package'}: not built — ${problems.length} problem(s)\n`);
  for (const line of problems) console.error(`  - ${line}`);
  console.error('');
  process.exit(1);
}

// ------------------------------------------------------------------ zip

const CRC_TABLE = Array.from({ length: 256 }, (_, n) => {
  let c = n;
  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
  return c >>> 0;
});
function crc32(buffer) {
  let crc = 0xffffffff;
  for (const byte of buffer) crc = CRC_TABLE[(crc ^ byte) & 0xff] ^ (crc >>> 8);
  return (crc ^ 0xffffffff) >>> 0;
}

/** A deflated zip, timestamps fixed at 1980-01-01 so the bytes depend on the content alone. */
function zip(files) {
  const DOS_DATE = (0 << 9) | (1 << 5) | 1;
  const local = [];
  const central = [];
  let offset = 0;
  for (const { name, data } of files) {
    const nameBytes = Buffer.from(name, 'utf8');
    const compressed = deflateRawSync(data, { level: 9 });
    const crc = crc32(data);
    const header = Buffer.alloc(30);
    header.writeUInt32LE(0x04034b50, 0);
    header.writeUInt16LE(20, 4);
    header.writeUInt16LE(0x0800, 6);
    header.writeUInt16LE(8, 8);
    header.writeUInt16LE(0, 10);
    header.writeUInt16LE(DOS_DATE, 12);
    header.writeUInt32LE(crc, 14);
    header.writeUInt32LE(compressed.length, 18);
    header.writeUInt32LE(data.length, 22);
    header.writeUInt16LE(nameBytes.length, 26);
    local.push(header, nameBytes, compressed);

    const record = Buffer.alloc(46);
    record.writeUInt32LE(0x02014b50, 0);
    record.writeUInt16LE(20, 4);
    record.writeUInt16LE(20, 6);
    record.writeUInt16LE(0x0800, 8);
    record.writeUInt16LE(8, 10);
    record.writeUInt16LE(0, 12);
    record.writeUInt16LE(DOS_DATE, 14);
    record.writeUInt32LE(crc, 16);
    record.writeUInt32LE(compressed.length, 20);
    record.writeUInt32LE(data.length, 24);
    record.writeUInt16LE(nameBytes.length, 28);
    record.writeUInt32LE(offset, 42);
    central.push(record, nameBytes);

    offset += header.length + nameBytes.length + compressed.length;
  }
  const directory = Buffer.concat(central);
  const end = Buffer.alloc(22);
  end.writeUInt32LE(0x06054b50, 0);
  end.writeUInt16LE(files.length, 8);
  end.writeUInt16LE(files.length, 10);
  end.writeUInt32LE(directory.length, 12);
  end.writeUInt32LE(offset, 16);
  return Buffer.concat([...local, directory, end]);
}

// The manifest first, as the JAR format expects; the rest by code point, which no locale reorders.
const byCodePoint = (a, b) => Buffer.compare(Buffer.from(a), Buffer.from(b));
entries.sort((a, b) =>
  a.name === MANIFEST_ENTRY ? -1 : b.name === MANIFEST_ENTRY ? 1 : byCodePoint(a.name, b.name),
);
const jar = zip(entries);
const archive = zip([
  { name: 'install.xml', data: readFileSync(join(HERE, 'package', 'install.xml')) },
  { name: `install/bundles/${packageName}.jar`, data: jar },
  { name: 'package.xml', data: Buffer.from(packageXml) },
]);

mkdirSync(OUT, { recursive: true });
const target = join(OUT, `${packageName}-${packageVersion}.zip`);
writeFileSync(target, archive);
const sha256 = createHash('sha256').update(archive).digest('hex');
console.log(`built ${relative(process.cwd(), target)}  (${archive.length} bytes, sha256 ${sha256})`);
for (const { name } of entries) console.log(`  bundle  ${name}`);
