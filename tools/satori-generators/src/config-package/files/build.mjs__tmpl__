#!/usr/bin/env node
/**
 * Build this configuration package: check it the way the server will, then write the zip.
 *
 *   node build.mjs [--out <directory>]        (default: ./dist next to this file)
 *
 * Generated by `@nuxeo-satori/platform:config-package`. No dependencies, so it runs anywhere Node
 * 20 does. The output is byte-for-byte reproducible — fixed timestamps, sorted entries — so the
 * same reviewed source always produces the same artifact.
 *
 * Refused, each with the file and the reason:
 *   - a JSON file that does not parse, is not an object, repeats a key, or exceeds 1 MiB — the
 *     server would leave that fragment out and report it, and the change would silently not apply;
 *   - a `src` in the component XML that names no file in `bundle/`;
 *   - a component XML without `<require>org.nuxeo.agentic.ui.config.defaults</require>`, without
 *     which this package's fragments could register before Satori's own and lose to them.
 *
 * Packaged: everything under `bundle/` except Markdown files, with a top-level `"$schema"` key
 * removed from each JSON file (it is for your editor, not the server).
 */
import { createHash } from 'node:crypto';
import { existsSync, mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';
import { dirname, join, relative, resolve, sep } from 'node:path';
import { fileURLToPath } from 'node:url';
import { deflateRawSync } from 'node:zlib';

const HERE = dirname(fileURLToPath(import.meta.url));
const BUNDLE = join(HERE, 'bundle');
const MAX_FRAGMENT_BYTES = 1024 * 1024;
const DEFAULTS_COMPONENT = 'org.nuxeo.agentic.ui.config.defaults';

const outIndex = process.argv.indexOf('--out');
const OUT = resolve(outIndex > 0 ? process.argv[outIndex + 1] : join(HERE, 'dist'));

const problems = [];
const problem = (file, message) => problems.push(`${relative(HERE, file)}: ${message}`);

function filesUnder(directory) {
  return readdirSync(directory).flatMap((entry) => {
    const path = join(directory, entry);
    return statSync(path).isDirectory() ? filesUnder(path) : [path];
  });
}

/**
 * Throws on a repeated key, which `JSON.parse` would accept by keeping the last value and the
 * server refuses. Validation only — the value is taken from `JSON.parse` afterwards.
 */
function rejectDuplicateKeys(text) {
  let i = 0;
  const token = (pattern) => {
    pattern.lastIndex = i;
    const match = pattern.exec(text);
    if (!match) throw new Error(`unexpected input at offset ${i}`);
    i = pattern.lastIndex;
    return match[0];
  };
  const STRING = /"(?:[^"\\\u0000-\u001f]|\\(?:["\\/bfnrt]|u[0-9a-fA-F]{4}))*"/y;
  const LITERAL = /-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?|true|false|null/y;
  const space = () => token(/[ \t\n\r]*/y);
  const value = (path) => {
    space();
    if (text[i] === '{') return object(path);
    if (text[i] === '[') return array(path);
    token(text[i] === '"' ? STRING : LITERAL);
  };
  const object = (path) => {
    i++;
    const seen = new Set();
    space();
    if (text[i] === '}') return void i++;
    for (;;) {
      space();
      const key = JSON.parse(token(STRING));
      if (seen.has(key)) throw new Error(`duplicate key "${key}" in ${path || 'the top level'}`);
      seen.add(key);
      space();
      token(/:/y);
      value(path ? `${path}.${key}` : key);
      space();
      if (text[i] === ',') i++;
      else if (text[i] === '}') return void i++;
      else throw new Error(`expected "," or "}" at offset ${i}`);
    }
  };
  const array = (path) => {
    i++;
    space();
    if (text[i] === ']') return void i++;
    for (let index = 0; ; index++) {
      value(`${path}[${index}]`);
      space();
      if (text[i] === ',') i++;
      else if (text[i] === ']') return void i++;
      else throw new Error(`expected "," or "]" at offset ${i}`);
    }
  };
  value('');
  space();
  if (i !== text.length) throw new Error(`unexpected input after the value at offset ${i}`);
}

function checkJson(file) {
  const bytes = readFileSync(file);
  if (bytes.length > MAX_FRAGMENT_BYTES) {
    problem(file, `${bytes.length} bytes; the server refuses a fragment over ${MAX_FRAGMENT_BYTES}`);
    return null;
  }
  const text = bytes.toString('utf8');
  let parsed;
  try {
    parsed = JSON.parse(text);
    rejectDuplicateKeys(text);
  } catch (error) {
    problem(file, error.message);
    return null;
  }
  if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
    problem(file, 'must be a JSON object');
    return null;
  }
  delete parsed.$schema;
  return Buffer.from(`${JSON.stringify(parsed, null, 2)}\n`);
}

// ------------------------------------------------------------------ package.xml

const packageXmlFile = join(HERE, 'package', 'package.xml');
const packageXml = readFileSync(packageXmlFile, 'utf8');
const packageTag = /<package\b[^>]*>/.exec(packageXml)?.[0] ?? '';
const attribute = (tag, name) => new RegExp(`\\b${name}="([^"]*)"`).exec(tag)?.[1];
const packageName = attribute(packageTag, 'name');
const packageVersion = attribute(packageTag, 'version');
if (!packageName || !packageVersion) problem(packageXmlFile, '<package> needs a name and a version');

// ------------------------------------------------------------------ bundle

const manifestFile = join(BUNDLE, 'META-INF', 'MANIFEST.MF');
const manifest = existsSync(manifestFile) ? readFileSync(manifestFile, 'utf8') : '';
const componentPaths = (/^Nuxeo-Component:\s*(.+?)\s*$/m.exec(manifest)?.[1] ?? '')
  .split(',')
  .map((path) => path.trim())
  .filter(Boolean);
if (componentPaths.length === 0) problem(manifestFile, 'needs a Nuxeo-Component line');

for (const componentPath of componentPaths) {
  const componentFile = join(BUNDLE, componentPath);
  if (!existsSync(componentFile)) {
    problem(manifestFile, `Nuxeo-Component names ${componentPath}, which does not exist`);
    continue;
  }
  // Comments removed first, so a commented-out example can neither satisfy nor fail a check.
  const xml = readFileSync(componentFile, 'utf8').replace(/<!--[\s\S]*?-->/g, '');
  const contributes = /target="org\.nuxeo\.agentic\.ui\.config"/.test(xml);
  const requiresDefaults = new RegExp(
    `<require>\\s*${DEFAULTS_COMPONENT.replace(/\./g, '\\.')}\\s*</require>`,
  ).test(xml);
  if (contributes && !requiresDefaults) {
    problem(
      componentFile,
      `must <require>${DEFAULTS_COMPONENT}</require>, or its fragments may apply before Satori's defaults`,
    );
  }
  for (const [, src] of xml.matchAll(/\bsrc="([^"]*)"/g)) {
    const target = resolve(BUNDLE, src);
    if (!target.startsWith(BUNDLE + sep) || !existsSync(target)) {
      problem(componentFile, `src="${src}" names no file in bundle/`);
    }
  }
}

const entries = [];
for (const file of filesUnder(BUNDLE).sort()) {
  if (file.endsWith('.md')) continue;
  const name = relative(BUNDLE, file).split(sep).join('/');
  const data = file.endsWith('.json') ? checkJson(file) : readFileSync(file);
  if (data) entries.push({ name, data });
}

if (problems.length > 0) {
  console.error(`\n${packageName ?? 'configuration package'}: not built — ${problems.length} problem(s)\n`);
  for (const line of problems) console.error(`  - ${line}`);
  console.error('');
  process.exit(1);
}

// ------------------------------------------------------------------ zip

const CRC_TABLE = Array.from({ length: 256 }, (_, n) => {
  let c = n;
  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
  return c >>> 0;
});
function crc32(buffer) {
  let crc = 0xffffffff;
  for (const byte of buffer) crc = CRC_TABLE[(crc ^ byte) & 0xff] ^ (crc >>> 8);
  return (crc ^ 0xffffffff) >>> 0;
}

/** A deflated zip, timestamps fixed at 1980-01-01 so the bytes depend on the content alone. */
function zip(files) {
  const DOS_DATE = (0 << 9) | (1 << 5) | 1;
  const local = [];
  const central = [];
  let offset = 0;
  for (const { name, data } of files) {
    const nameBytes = Buffer.from(name, 'utf8');
    const compressed = deflateRawSync(data, { level: 9 });
    const crc = crc32(data);
    const header = Buffer.alloc(30);
    header.writeUInt32LE(0x04034b50, 0);
    header.writeUInt16LE(20, 4);
    header.writeUInt16LE(0x0800, 6);
    header.writeUInt16LE(8, 8);
    header.writeUInt16LE(0, 10);
    header.writeUInt16LE(DOS_DATE, 12);
    header.writeUInt32LE(crc, 14);
    header.writeUInt32LE(compressed.length, 18);
    header.writeUInt32LE(data.length, 22);
    header.writeUInt16LE(nameBytes.length, 26);
    local.push(header, nameBytes, compressed);

    const record = Buffer.alloc(46);
    record.writeUInt32LE(0x02014b50, 0);
    record.writeUInt16LE(20, 4);
    record.writeUInt16LE(20, 6);
    record.writeUInt16LE(0x0800, 8);
    record.writeUInt16LE(8, 10);
    record.writeUInt16LE(0, 12);
    record.writeUInt16LE(DOS_DATE, 14);
    record.writeUInt32LE(crc, 16);
    record.writeUInt32LE(compressed.length, 20);
    record.writeUInt32LE(data.length, 24);
    record.writeUInt16LE(nameBytes.length, 28);
    record.writeUInt32LE(offset, 42);
    central.push(record, nameBytes);

    offset += header.length + nameBytes.length + compressed.length;
  }
  const directory = Buffer.concat(central);
  const end = Buffer.alloc(22);
  end.writeUInt32LE(0x06054b50, 0);
  end.writeUInt16LE(files.length, 8);
  end.writeUInt16LE(files.length, 10);
  end.writeUInt32LE(directory.length, 12);
  end.writeUInt32LE(offset, 16);
  return Buffer.concat([...local, directory, end]);
}

// The manifest first, as the JAR format expects.
entries.sort((a, b) =>
  a.name === 'META-INF/MANIFEST.MF' ? -1 : b.name === 'META-INF/MANIFEST.MF' ? 1 : a.name.localeCompare(b.name),
);
const jar = zip(entries);
const archive = zip([
  { name: 'install.xml', data: readFileSync(join(HERE, 'package', 'install.xml')) },
  { name: `install/bundles/${packageName}.jar`, data: jar },
  { name: 'package.xml', data: Buffer.from(packageXml) },
]);

mkdirSync(OUT, { recursive: true });
const target = join(OUT, `${packageName}-${packageVersion}.zip`);
writeFileSync(target, archive);
const sha256 = createHash('sha256').update(archive).digest('hex');
console.log(`built ${relative(process.cwd(), target)}  (${archive.length} bytes, sha256 ${sha256})`);
for (const { name } of entries) console.log(`  bundle  ${name}`);
