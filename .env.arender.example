ARENDER_VERSION=2023.19.0
# Base64-encoded "username:password" for the Nuxeo Basic Auth the nginx sidecar
# injects on ARender's behalf. Generate with:
#   echo -n "<username>:<password>" | base64
# Use your own local Nuxeo account. Never commit a filled-in value: this file
# is the template, .env.arender is gitignored.
NUXEO_BASIC_AUTH=
