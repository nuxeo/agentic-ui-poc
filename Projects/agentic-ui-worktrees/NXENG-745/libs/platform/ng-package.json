{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/platform",
  "assets": [
    "README.md",
    "extension-reference.md",
    "AGENTS.md",
    "generators.json",
    {
      "glob": "**/*.mjs",
      "input": "guardrails",
      "output": "guardrails"
    },
    {
      "glob": "**/*",
      "input": "generators",
      "output": "generators"
    }
  ],
  "lib": {
    "entryFile": "src/index.ts"
  },
  "allowedNonPeerDependencies": ["dompurify"]
}
