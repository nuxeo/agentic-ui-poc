{
  "name": "@hylandsoftware/satori-ui",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HylandSoftware/satori.git"
  },
  "peerDependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.21",
    "@angular/core": "^20.3.21",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.21",
    "@angular/router": "^20.3.21",
    "@ngx-translate/core": "^17.0.0",
    "rxjs": "^7.8.0",
    "sass": "^1.85.0"
  },
  "dependencies": {
    "@hylandsoftware/satori-fonts": "^3.0.0",
    "@hylandsoftware/satori-icons": "^3.0.0",
    "@hylandsoftware/satori-tokens": "^0.6.0",
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "exports": {
    "./theme": {
      "sass": "./theme/_index.scss"
    },
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui.mjs"
    },
    "./app-header": {
      "types": "./app-header/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-app-header.mjs"
    },
    "./avatar": {
      "types": "./avatar/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-avatar.mjs"
    },
    "./breadcrumbs": {
      "types": "./breadcrumbs/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-breadcrumbs.mjs"
    },
    "./focus-indicator": {
      "types": "./focus-indicator/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-focus-indicator.mjs"
    },
    "./icons": {
      "types": "./icons/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-icons.mjs"
    },
    "./logo": {
      "types": "./logo/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-logo.mjs"
    },
    "./platform-nav": {
      "types": "./platform-nav/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-platform-nav.mjs"
    },
    "./providers": {
      "types": "./providers/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-providers.mjs"
    },
    "./rich-tooltip": {
      "types": "./rich-tooltip/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-rich-tooltip.mjs"
    },
    "./tag": {
      "types": "./tag/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-tag.mjs"
    },
    "./translations": {
      "types": "./translations/index.d.ts",
      "default": "./fesm2022/hylandsoftware-satori-ui-translations.mjs"
    }
  },
  "module": "fesm2022/hylandsoftware-satori-ui.mjs",
  "typings": "index.d.ts"
}
