{
  "name": "@hylandsoftware/satori-icons",
  "version": "3.9.0",
  "description": "Source of icons used in the Satori ecosystem",
  "main": "index.mjs",
  "type": "module",
  "types": "index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts",
    "index.html",
    "readme.md",
    "deprecated-icons.json",
    "icon-list.json"
  ],
  "scripts": {
    "serve": "serve .",
    "playwright:install": "npx playwright install",
    "vr": "node node_modules/backstopjs/cli/index.js",
    "vr:config": "node ./generate-backstop-config.js",
    "vr:test": "npm run vr test",
    "vr:approve": "npm run vr approve",
    "test:removed-icons": "node --test ./removed-icons.test.js",
    "test:icon-comparison": "node --test .github/actions/compare-icon-list/compare-icons.test.js",
    "snapshot:regenerate": "node ./test-utils/regenerate-snapshot.js",
    "figma:publish": "npx figma connect publish"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.7",
    "backstopjs": "^6.3.25",
    "jsdom": "^30.0.0",
    "serve": "^14.2.5"
  }
}
